set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(MINGW_TOOLCHAIN_PREFIX "x86_64-w64-mingw32" CACHE STRING "MinGW command prefix, optionally including its directory")
set(CMAKE_C_COMPILER "${MINGW_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${MINGW_TOOLCHAIN_PREFIX}-g++")
set(CMAKE_RC_COMPILER "${MINGW_TOOLCHAIN_PREFIX}-windres")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MINGW_TOOLCHAIN_PREFIX)
