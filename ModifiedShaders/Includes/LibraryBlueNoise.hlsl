//rank of a pixel in one of the two tiles, as an evenly spread value in (0, 1)
float BlueNoiseRank(uint2 pixCoord, uint tile)
{
    uint index = tile * 4096u + (pixCoord.y & 63u) * 64u + (pixCoord.x & 63u);
    return ((float)((BlueNoiseTable[index >> 2] >> ((index & 3u) * 8u)) & 0xFFu) + 0.5f) * (1.0f / 256.0f);
}

//three blue noise values per pixel, stepped every frame along low discrepancy sequences (1/plastic, 1/plastic^2 and sqrt(2) - 1,
//as 0.32 fixed point so it stays exact for any frame count).
//every frame is a blue noise pattern with no single stripe frequency (interleaved gradient noise puts most of its energy into one,
//which DLSS can hold on screen as a still grid), and every pixel steps through evenly spread values over time,
//so TAA/DLSS blends it away without leaving a pattern behind.
//reference - http://extremelearning.com.au/unreasonable-effectiveness-of-quasirandom-sequences/
float3 SpatiotemporalBlueNoise(uint2 pixCoord, uint frameCount)
{
    float3 noise = float3(BlueNoiseRank(pixCoord, 0u), BlueNoiseRank(pixCoord, 1u), BlueNoiseRank(pixCoord + uint2(32u, 32u), 0u));
    uint3 steps = frameCount * uint3(3242174889u, 2447445414u, 1779033704u);
    return frac(noise + (float3)(steps >> 8u) * (1.0f / 16777216.0f));
}

